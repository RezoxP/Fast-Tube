+
+    // Re-inject Fast-Tube on document load complete to ensure styles and DOM hooks
+    InjectFastTubeScript();
+  }
+
+  void InjectFastTubeScript() {
+    // Generate an epoch timestamp to bypass caching (auto-update)
+    double epoch_time = base::Time::Now().ToDoubleT();
+    std::string url = "https://cdn.jsdelivr.net/gh/RezoxP/Fast-Tube@main/scripts/injection/vacuumtube_adblock.js?v=" + std::to_string(epoch_time);
+
+    // Inject a <script> tag to load the remote script, exactly like TizenTube
+    std::string js_code = 
+        "var script = document.createElement('script');"
+        "script.src = '" + url + "';"
+        "if (document.head) {"
+        "  document.head.appendChild(script);"
+        "} else {"
+        "  document.documentElement.appendChild(script);"
+        "}";
+
+    bool succeeded = false;
+    ExecuteJavascript(js_code, base::SourceLocation("vacuumtube_adblock_injector.js", 1, 1), NULL, &succeeded);
+    LOG(INFO) << "[Fast-Tube] Auto-update script injection result: " << succeeded;
+  }
 
   // Inject the DOM event object into the window or the element.
