+
+    const AD_URL_PATTERNS = ['/api/stats/ads', '/ptracking', '/pagead/', 'googleads.g.doubleclick.net', 'doubleclick.net', 'adservice.google.com'];
+    function isAdUrl(url) {
+        if (!url || typeof url !== 'string') return false;
