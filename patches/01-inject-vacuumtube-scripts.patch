+++ b/cobalt/browser/web_module.cc
@@ -20,6 +20,10 @@
 
 #include "base/bind.h"
 #include "base/callback.h"
+#include "base/files/file_util.h"
+#include "base/path_service.h"
+#include "cobalt/base/cobalt_paths.h"
+#include "starboard/system.h"
 #include "base/command_line.h"
 #include "base/logging.h"
 #include "base/memory/weak_ptr.h"
@@ -345,6 +349,37 @@ class WebModule::Impl {
             window_->performance(), load_timing_info);
       }
     }
+
+    // Re-inject Fast-Tube on document load complete to ensure styles and DOM hooks
+    InjectFastTubeScript();
+  }
+
+  void InjectFastTubeScript() {
+    // 1. Try to fetch the latest script from GitHub synchronously for realtime auto-update
+    std::string js_fetch_code = 
+      "try {"
+      "  var xhr = new XMLHttpRequest();"
+      "  xhr.open('GET', 'https://raw.githubusercontent.com/RezoxP/Fast-Tube/main/scripts/injection/vacuumtube_adblock.js?v=' + Date.now(), false);"
+      "  xhr.send(null);"
+      "  if (xhr.status === 200 && xhr.responseText) {"
+      "    eval(xhr.responseText);"
+      "    window.__ft_injected_remote = true;"
+      "  }"
+      "} catch(e) {}";
+    
+    bool remote_succeeded = false;
+    ExecuteJavascript(js_fetch_code, base::SourceLocation("ft_auto_update.js", 1, 1), NULL, &remote_succeeded);
+
+    // 2. Read the local embedded script as a fallback
+    std::string adblock_script;
+    base::FilePath web_root;
+    if (base::PathService::Get(cobalt::paths::DIR_COBALT_WEB_ROOT, &web_root)) {
+      base::ReadFileToString(web_root.Append("vacuumtube_adblock.js"), &adblock_script);
+      if (adblock_script.empty()) {
+        base::ReadFileToString(web_root.Append("injection").Append("vacuumtube_adblock.js"), &adblock_script);
+      }
+    }
+    if (adblock_script.empty()) {
+      char content_dir[512] = {0};
+      if (SbSystemGetPath(kSbSystemPathContentDirectory, content_dir, sizeof(content_dir))) {
+        base::ReadFileToString(base::FilePath(content_dir).Append("vacuumtube_adblock.js"), &adblock_script);
+        if (adblock_script.empty()) {
+          base::ReadFileToString(base::FilePath(content_dir).Append("web").Append("vacuumtube_adblock.js"), &adblock_script);
+        }
+        if (adblock_script.empty()) {
+          base::ReadFileToString(base::FilePath(content_dir).Append("injection").Append("vacuumtube_adblock.js"), &adblock_script);
+        }
+      }
+    }
+    if (!adblock_script.empty()) {
+      std::string js_fallback = "if (!window.__ft_injected_remote) {\n" + adblock_script + "\n}";
+      bool fallback_succeeded = false;
+      ExecuteJavascript(js_fallback, base::SourceLocation("vacuumtube_adblock.js", 1, 1), NULL, &fallback_succeeded);
+    }
   }
 
   // Inject the DOM event object into the window or the element.
@@ -747,6 +782,9 @@ WebModule::Impl::Impl(web::Context* web_context, const ConstructionData& data)
 
